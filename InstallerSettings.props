<Project>
  <PropertyGroup>
    <!-- Local defaults for setup bundle builds; CI overrides these via -p: properties. -->
    <CleverVpnInstallerVersion Condition="'$(CleverVpnInstallerVersion)'==''">0.0.0.0</CleverVpnInstallerVersion>
    <!-- Where setup.exe downloads its MSIs from at install time. It is compiled into the bundle,
         so each release mode passes its own URL: a stable release uses the download host, a
         prerelease uses its own release assets. This default is for local builds only. -->
    <InstallerDownloadBaseUrl Condition="'$(InstallerDownloadBaseUrl)'==''">https://download.clever-vpn.net/windows</InstallerDownloadBaseUrl>
    <MsiSourceRoot Condition="'$(MsiSourceRoot)'==''">..\MsiInstaller\bin</MsiSourceRoot>
  </PropertyGroup>
</Project>
